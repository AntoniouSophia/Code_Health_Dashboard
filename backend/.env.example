# Αντιγράψτε σε backend/.env και συμπληρώστε
# τα στοιχεία της τοπικής εγκατάστασής σας.

# Backend
PORT=3000

# Βάση εφαρμογής
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analyzed_projects
# Βάλτε χρήστη που υπάρχει στη δική σας MariaDB.
DB_USER=
DB_PASSWORD=

# SonarQube
SONAR_URL=http://localhost:9000
SONAR_TOKEN=

# Φάκελος εγκατάστασης scanner, όχι bin ή αρχείο .bat.
# Windows, π.χ. C:/tools/sonar-scanner
# Linux, π.χ. /opt/sonar-scanner
# Κενό: ο scanner πρέπει να υπάρχει στο PATH.
SONAR_SCANNER_HOME=

SONAR_POLL_INTERVAL_MS=2000
SONAR_ANALYSIS_TIMEOUT_MS=120000

# AllinCode: συμπληρώστε URL και στοιχεία λογαριασμού.
ALLINCODE_BASE_URL=
ALLINCODE_EMAIL=
ALLINCODE_PASSWORD=
ALLINCODE_POLL_INTERVAL_MS=5000
ALLINCODE_ANALYSIS_TIMEOUT_MS=86400000
ALLINCODE_STEP_STALL_TIMEOUT_MS=3600000

# Python: python στα Windows, συνήθως python3 στο Linux.
# Για το Linux venv του README: ./.venv/bin/python
PYTHON_CMD=python

# Σχετικές διαδρομές ως προς backend/
PROCESSING_DIR=../processing
RESULTS_DIR=./results
TEMP_DIR=./tmp

# Αν προκύπτουν μεγάλες διαδρομές στα Windows,
# αντικαταστήστε το TEMP_DIR με σύντομη διαδρομή,
# π.χ. TEMP_DIR=C:/chd-tmp