# Copy this file to backend/.env and fill in
# the details of your local installation.

# Backend
PORT=3000

# Application database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analyzed_projects
# Use an existing user from your MariaDB installation.
DB_USER=root
DB_PASSWORD=

# SonarQube
SONAR_URL=http://localhost:9000
SONAR_TOKEN=your_token

# Scanner installation directory, not bin or the .bat file.
# Windows, e.g. C:/tools/sonar-scanner
# Linux, e.g. /opt/sonar-scanner
# If left empty, the scanner must be available in PATH.
SONAR_SCANNER_HOME=

SONAR_POLL_INTERVAL_MS=2000
SONAR_ANALYSIS_TIMEOUT_MS=120000

# DEBTclock: provide the API URL and account credentials.
ALLINCODE_BASE_URL=https://se.uom.gr/backend-debtclock
ALLINCODE_EMAIL=uom@gr
ALLINCODE_PASSWORD=uom
ALLINCODE_POLL_INTERVAL_MS=5000
ALLINCODE_ANALYSIS_TIMEOUT_MS=86400000
ALLINCODE_STEP_STALL_TIMEOUT_MS=3600000

# Python: python on Windows, usually python3 on Linux.
# For the Linux virtual environment described in the README: ./.venv/bin/python
PYTHON_CMD=python

# Relative paths are resolved from backend/
PROCESSING_DIR=../processing
RESULTS_DIR=./results
TEMP_DIR=./tmp

# If long paths cause issues on Windows,
# replace TEMP_DIR with a shorter path,
# e.g. TEMP_DIR=C:/chd-tmp