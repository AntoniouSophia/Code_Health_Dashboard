# Αντιγράψτε σε .env στον ίδιο φάκελο με το docker-compose.yml.
# Μην αλλάζετε το COMPOSE_PROJECT_NAME υπάρχουσας εγκατάστασης:
# καθορίζει ποια volumes χρησιμοποιούνται.
COMPOSE_PROJECT_NAME=code_health_dashboard_test

# Πρόσβαση από το τοπικό μηχάνημα
BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173
SONAR_HOST_PORT=9000

# Images
MARIADB_IMAGE=mariadb:10.11
SONARQUBE_IMAGE=sonarqube:26.10.0.133078-community

# SQL πρώτης αρχικοποίησης: σχήμα και παραδείγματα.
# Για κενή βάση: ./database/schema.sql
SQL_INIT_FILE=./database/schema_with_example_data.sql

# Βάση εφαρμογής
DB_HOST=db
DB_PORT=3306
DB_NAME=analyzed_projects
DB_USER=

# Συμπληρώστε δύο νέους, μη κενούς κωδικούς.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Backend
PORT=3000

# SonarQube
SONAR_PORT=9000
SONAR_URL=http://sonarqube:9000
# Δημιουργήστε token στη συγκεκριμένη εγκατάσταση SonarQube.
SONAR_TOKEN=
SONAR_SCANNER_HOME=/opt/sonar-scanner
SONAR_POLL_INTERVAL_MS=2000
SONAR_ANALYSIS_TIMEOUT_MS=120000

# AllinCode: συμπληρώστε URL και στοιχεία λογαριασμού.
ALLINCODE_BASE_URL=
ALLINCODE_EMAIL=
ALLINCODE_PASSWORD=
ALLINCODE_POLL_INTERVAL_MS=5000
ALLINCODE_ANALYSIS_TIMEOUT_MS=86400000
ALLINCODE_STEP_STALL_TIMEOUT_MS=3600000

# Διαδρομές μέσα στο backend container
PYTHON_CMD=/opt/venv/bin/python
PROCESSING_DIR=/app/processing
RESULTS_DIR=/app/backend/results
TEMP_DIR=/app/backend/tmp

# Frontend: το API URL χρησιμοποιείται από τον browser.
VITE_API_URL=http://localhost:3000
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173