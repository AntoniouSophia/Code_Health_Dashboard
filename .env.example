# Copy this file to .env in the same directory as docker-compose.yml.
# Do not change COMPOSE_PROJECT_NAME for an existing installation:
# it determines which Docker volumes are used.
COMPOSE_PROJECT_NAME=code_health_dashboard_test

# Access from the local machine
BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173
SONAR_HOST_PORT=9000

# Images
MARIADB_IMAGE=mariadb:10.11
SONARQUBE_IMAGE=sonarqube:26.10.0.133078-community

# SQL initialization: schema and example data.
# For an empty database: ./database/schema.sql
SQL_INIT_FILE=./database/schema_with_example_data.sql

# Application database
DB_HOST=db
DB_PORT=3306
DB_NAME=analyzed_projects
DB_USER=codehealth

# Set new passwords, for example:
DB_PASSWORD=docker
DB_ROOT_PASSWORD=docker

# Backend
PORT=3000

# SonarQube
SONAR_PORT=9000
SONAR_URL=http://sonarqube:9000
# Generate a token for this specific SonarQube installation.
SONAR_TOKEN=
SONAR_SCANNER_HOME=/opt/sonar-scanner
SONAR_POLL_INTERVAL_MS=2000
SONAR_ANALYSIS_TIMEOUT_MS=120000

# DEBTclock: provide the API URL and account credentials.
ALLINCODE_BASE_URL=https://se.uom.gr/backend-debtclock
ALLINCODE_EMAIL=uom@gr
ALLINCODE_PASSWORD=uom
ALLINCODE_POLL_INTERVAL_MS=5000
ALLINCODE_ANALYSIS_TIMEOUT_MS=86400000
ALLINCODE_STEP_STALL_TIMEOUT_MS=3600000

# Paths inside the backend container
PYTHON_CMD=/opt/venv/bin/python
PROCESSING_DIR=/app/processing
RESULTS_DIR=/app/backend/results
TEMP_DIR=/app/backend/tmp

# Frontend: the API URL is accessed by the browser.
VITE_API_URL=http://localhost:3000
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173